Cell[TextData[{
 "Rakupp interpreter interaction functions based on ",
 ButtonBox["Foreign Function Interface",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/ForeignFunctions.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/ForeignFunctions.html"],
 "."
}], "Text",
