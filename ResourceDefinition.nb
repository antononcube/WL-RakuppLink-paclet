 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"0762e722-ce7a-46c4-b9e2-70a90e84162c"],

Cell[TextData[{
 ButtonBox["Rakupp",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/ash/rakupp"], None},
  ButtonNote->"https://github.com/ash/rakupp"],
 " is a from-scratch implementation of the Raku programming language in C++17."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996764288574205*^9, 3.996764344241497*^9}},
 CellTags->"DefaultContent",
 CellID->741278932,ExpressionUUID->"baf2e316-80d9-4d3e-b342-bfb19d3877d8"],

Cell[TextData[{
 "The Wolfram Language (WL) binding is one of the bindings provided by ",
 ButtonBox["Rakupp's GitHub repository",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/ash/rakupp"], None},
  ButtonNote->"https://github.com/ash/rakupp"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9967643460880413`*^9, 3.9967643927271957`*^9}},
 CellID->834705139,ExpressionUUID->"3aa869cf-b89f-405b-a919-6f16a3ccd226"],

Cell[TextData[{
 "Rakupp has to be installed before using this paclet -- see the direections \
in ",
 ButtonBox["Rakupp's main README",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/ash/rakupp"], None},
  ButtonNote->"https://github.com/ash/rakupp"],
 " and ",
 ButtonBox["WL's binding README",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/ash/rakupp/tree/main/bindings/wolfram"], None},
  ButtonNote->"https://github.com/ash/rakupp/tree/main/bindings/wolfram"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9967644224845257`*^9, 3.996764513930792*^9}},
 CellID->976199727,ExpressionUUID->"6c4d3098-73eb-4cd8-960b-0ef1bc72b87f"],

Cell["\<\
One interpreter per Wolfram kernel process, created on first use.\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996831837872569*^9, 3.9968318456856337`*^9}},
 CellID->1378227305,ExpressionUUID->"e6f5ec56-3e5e-4280-9498-f1ba909166f2"],

Cell["\<\
One kernel thread talks to it (Raku code inside threads freely).\
\>", "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.996831850278634*^9, 3.99683186070383*^9}, 
   3.996831959950301*^9, 3.996832186917136*^9},
 CellID->74603607,ExpressionUUID->"c48388b3-9d5d-4d5a-8b7f-55d0f89a638f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Primary Context",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"PrimaryContext", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "Specify the primary context of your paclet that users should load \
with ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
               ButtonBox[
                StyleBox[
                "Needs", "SymbolsRefLink", ShowStringCharacters -> True, 
                 FontFamily -> "Source Sans Pro"], BaseStyle -> Dynamic[
                  FEPrivate`If[
                   CurrentValue["MouseOver"], {
                   "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
                   "Link"}]], ButtonData -> "paclet:ref/Needs", 
                ContentPadding -> False], 
               MouseAppearanceTag["LinkHand"]], ShowStringCharacters -> True, 
              FontFamily -> "Source Sans Pro"]]], " or ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
               ButtonBox[
                StyleBox[
                "Get", "SymbolsRefLink", ShowStringCharacters -> True, 
                 FontFamily -> "Source Sans Pro"], BaseStyle -> Dynamic[
                  FEPrivate`If[
                   CurrentValue["MouseOver"], {
                   "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
                   "Link"}]], ButtonData -> "paclet:ref/Get", ContentPadding -> 
                False], 
               MouseAppearanceTag["LinkHand"]], ShowStringCharacters -> True, 
              FontFamily -> "Source Sans Pro"]]], 
           " in order to access the paclet's functionality. If your paclet is \
not meant to be loaded via a context, this section can be left blank. If \
specified, the primary context will also be displayed on the main web page \
for your paclet."}], "MoreInfoText"], Background -> GrayLevel[0.95], 
        FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], RoundingRadius -> 5,
         ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoPrimaryContext"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "59065986-37d3-44eb-bd4b-ce304d359cfc"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "PrimaryContext"},
