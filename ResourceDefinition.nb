Cell["Define a Raku sub:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.996768483610794*^9, 3.9967684933441*^9}},
 CellID->1779590273,ExpressionUUID->"0909138b-f6d6-41fd-a8a1-1988ed37d8f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RakuppEval", 
  "[", "\"\<\nproto sub fib (Int $n --> Int) {*}\nmulti sub fib (0)  { 0 }\n\
multi sub fib (1)  { 1 }\nmulti sub fib ($n) { fib($n - 1) + fib($n - 2) }\n\
\>\"", "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.996768539007348*^9, 3.996768550496066*^9}, {
