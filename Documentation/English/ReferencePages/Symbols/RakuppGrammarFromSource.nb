Cell["Setup the RAKUPP_LIB environmental variable:", "ExampleText",
 TaggingRules->{},
 CellChangeTimes->{{3.996764577148527*^9, 3.996764600098921*^9}},
 CellTags->"DefaultContent",
 CellID->489008670,ExpressionUUID->"3cf28bca-fb2e-434b-a050-94e91d5d5dd8"],

Cell[BoxData[
 RowBox[{"SetEnvironment", "[", 
  RowBox[{"\"\<RAKUPP_LIB\>\"", "->", 
   RowBox[{
   "$HomeDirectory", 
    "<>", "\"\</GitHub/ash/rakupp/build/librakupp.dylib\>\""}]}], 
  "]"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.996655294713275*^9, 3.9966553437485733`*^9}, 
   3.996655390850614*^9},
 CellLabel->"In[3]:=",
 CellID->395463386,ExpressionUUID->"54a616a3-8bad-4fd7-a1fe-0f73f162333e"],

Cell["Here is a string with a Raku-language defined grammar:", "ExampleText",
 TaggingRules->{},
 CellChangeTimes->{{3.996766449507657*^9, 3.996766465547415*^9}, {
  3.996770137609591*^9, 3.996770138030241*^9}},
 CellID->45348425,ExpressionUUID->"6c098156-dcd0-43e7-a84d-67cc3bad5a63"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "rkCode", 
   "=", "\"\<\ngrammar Parser {\n    rule  TOP  { <who> <verb> <lang> }\n    \
token who  {:i I | you | we | they }\n    token verb { <love> | <hate> }\n    \
token love { '\:2764\:fe0f' | '\:2665' | love }\n\ttoken hate { '\|01f92e' | \
hate }\n    token lang {:i < Raku Rust Go Python Ruby TypeScript PHP WL> }\n}\
\n\>\""}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.996766468728753*^9, 3.996766525742021*^9}, {
  3.996766600954153*^9, 3.996766640089714*^9}, {3.9967666763408537`*^9, 
  3.996766747655488*^9}, {3.996767286137021*^9, 3.996767312370804*^9}, {
  3.9967673698966846`*^9, 3.9967673941348963`*^9}},
 CellLabel->"In[62]:=",
 CellID->1998461980,ExpressionUUID->"57971e1c-7bc0-4225-bd41-4828b98b7d9a"],

Cell["Compile the grammar in Rakupp interpreter:", "ExampleText",
 TaggingRules->{},
 CellChangeTimes->{{3.99676689501285*^9, 3.996766917348742*^9}},
 CellID->1830033676,ExpressionUUID->"66fad077-1232-42bf-bae9-eb72b6c78b7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "=", 
  RowBox[{"RakuppGrammarFromSource", "[", "rkCode", "]"}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9967665602109737`*^9, 3.9967665705926247`*^9}},
 CellLabel->"In[67]:=",
 CellID->1228791405,ExpressionUUID->"3471f77f-e650-40cb-ad40-268a4dfd68ba"],

