Cell["RakuppGrammarFromSource", "ObjectName",
 CellID->138825928,ExpressionUUID->"bae3aa54-a402-4e8c-90c2-3c60e5ff6457"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"30dc41b4-08bb-4d2d-bc02-69d2635fa080"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RakuppGrammarFromSource",
    BaseStyle->"Link",
    ButtonData->"paclet:AntonAntonovRakuppLink/ref/RakuppGrammarFromSource"], 
   "[", 
   RowBox[{
    StyleBox["src", "TI"], ",", 
    RowBox[{"\"\<Name\>\"", " ", "\[Rule]", "  ", 
     StyleBox["\[Ellipsis]", "TR"]}], ",", 
    RowBox[{"\"\<Actions\>\"", " ", "\[Rule]", "  ", 
     StyleBox["\[Ellipsis]", "TR"]}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5a25e219-5c92-44b1-abca-120384d0a579"],
 "\[LineSeparator]compiles Raku grammar source and returns a ",
 Cell[BoxData[
  ButtonBox["RakuppGrammar",
   BaseStyle->"Link",
   ButtonData->"paclet:AntonAntonov/RakuppLink/ref/RakuppGrammar"]], 
  "InlineFormula",ExpressionUUID->"3260b59e-801b-465f-a022-0a04a7397a98"],
 ". \"Name\" is the grammar's name in the source and may be omitted only when \
the grammar declaration is the source's last statement; \"Actions\" names an \
actions class in the same source."
}], "Usage",
 CellChangeTimes->{3.996767058972549*^9},
 CellID->1080131254,ExpressionUUID->"43c02f9d-e314-4cdf-a1c9-17c4a0559376"],

