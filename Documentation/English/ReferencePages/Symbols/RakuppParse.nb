Cell[CellGroupData[{
Cell["RakuppParse", "ObjectName",
 CellID->781525577,ExpressionUUID->"ad09f41d-ab70-4619-a8cc-eb923eb3cd24"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a381b2e-7c56-424b-8b12-929f3322539c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RakuppParse",
    BaseStyle->"Link",
    ButtonData->"paclet:AntonAntonovRakuppLink/ref/RakuppParse"], "[", 
   RowBox[{
    StyleBox["grammar", "TI"], ",", 
    StyleBox["text", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ed39e599-b8bf-46b7-86f4-6288391d5ecc"],
 "\[LineSeparator]parses ",
 Cell[BoxData[
  StyleBox["text", "TI"]], "InlineFormula",ExpressionUUID->
  "73cf140d-cff3-41eb-9ed2-68974d9cc474"],
 " and returns a ",
 Cell[BoxData[
  ButtonBox["RakuppMatch",
   BaseStyle->"Link",
   ButtonData->"paclet:AntonAntonov/RakuppLink/ref/RakuppMatch"]], 
  "InlineFormula",ExpressionUUID->"5cd9cfe3-1279-4102-9832-c43c9a19bb5d"],
 ", or ",
 Cell[BoxData[
  ButtonBox["None",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "7efb9bbc-238d-4fca-881a-72ff4abda135"],
 " when the parse fails. ",
 Cell[BoxData[
  RowBox[{"\"\<Rule\>\"", "->", "name"}]], "InlineFormula",ExpressionUUID->
  "ccc5e6f5-df62-4834-ad51-09ed10ae5f72"],
 " parses a fragment with one rule; ",
 Cell[BoxData[
  RowBox[{"\"\<Strict\>\"", "->", 
   ButtonBox["True",
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "72650951-9c7a-41b1-b57e-81e6192e9b63"],
 " returns a diagnosed ",
 Cell[BoxData[
  ButtonBox["Failure",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "362ca41e-11f0-4cd7-9b89-1f41121e707d"],
 "[\"\n",
 Cell["   ", "ModInfo",ExpressionUUID->"08e062b1-38dd-492d-8d90-753bc2f37e82"],
 "RakuppParse\[LineSeparator]Error\",...] instead of ",
 Cell[BoxData[
  ButtonBox["None",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "c9d24613-dce9-4481-8328-d518bc24145b"],
 "."
}], "Usage",
