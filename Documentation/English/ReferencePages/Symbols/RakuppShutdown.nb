Notebook[{

Cell[CellGroupData[{
Cell["RakuppShutdown", "ObjectName",
 CellID->1182033641,ExpressionUUID->"214e049b-b390-47db-9596-6ef7edef8358"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8572cf94-7da1-4c9f-987a-84b3a2d5db7c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RakuppShutdown",
    BaseStyle->"Link",
    ButtonData->"paclet:AntonAntonovRakuppLink/ref/RakuppShutdown"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "df8c51a0-c973-480d-90a5-1e0ee2a29bbb"],
 "\[LineSeparator]frees the interpreter. Every ",
 Cell[BoxData[
  ButtonBox["RakuppGrammar",
   BaseStyle->"Link",
   ButtonData->"paclet:AntonAntonov/RakuppLink/ref/RakuppGrammar"]], 
  "InlineFormula",ExpressionUUID->"de051bbb-7970-4617-a573-00deb460f135"],
 " and ",
 Cell[BoxData[
  ButtonBox["RakuppMatch",
   BaseStyle->"Link",
   ButtonData->"paclet:AntonAntonov/RakuppLink/ref/RakuppMatch"]], 
  "InlineFormula",ExpressionUUID->"a306db91-1117-4a92-b7b5-f1fc30c642a0"],
 " from it is dead afterwards; a fresh one may then be started."
}], "Usage",
 CellChangeTimes->{3.9967670612522993`*^9},
 CellID->68185890,ExpressionUUID->"2cf8058d-6f28-4124-940d-0888888eca03"],

